# Local development only. Do not point this at a shared database.
# A host dashboard URL starting with postgres:// or postgresql:// is rewritten
# to postgresql+psycopg:// when the API starts.
DATABASE_URL=postgresql+psycopg://itaudit:itaudit@localhost:5433/itaudit
# On a public site, set this to the page origin, for example https://your-app.vercel.app
CORS_ORIGINS=http://localhost:5173

# Frontend production build only. Public URL of the API, no trailing slash.
# Leave it empty locally so Vite proxies /api to the API on port 8000.
# VITE_API_URL=https://your-api.up.railway.app

# Set to false on a deployed build to hide company-data import.
ALLOW_REAL_DATA=true

# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-5
